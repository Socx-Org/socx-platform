# reference/security — local development .env pattern (SEC-010.1, SEC-010.2)
#
# Copy to .env in your local checkout. This file itself (.env.example) is
# safe to commit -- every value below is a placeholder, never a real secret.
#
# .env, .env.*, and every variant except .env.example MUST be in .gitignore
# from the moment a repository is created (SEC-010.2) -- not added
# reactively after the fact. See this manifest's Usage section for the
# exact .gitignore lines.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://{{DB_USER}}:{{DB_PASSWORD}}@localhost:5432/{{DB_NAME}}

# Auth -- generate real values locally with, e.g., `openssl rand -base64 32`.
# Never reuse a value from this file, and never commit a real one.
JWT_SECRET={{GENERATE_LOCALLY_DO_NOT_COMMIT}}
JWT_REFRESH_SECRET={{GENERATE_LOCALLY_DO_NOT_COMMIT}}

# Add project-specific variables below, following the same convention:
# a placeholder here, a real value only in the untracked local .env.
