# reference/systemd — direct-execution API service unit (ADR-040)
# Copy to /etc/systemd/system/{{APP_NAME}}-api.service and substitute all {{PLACEHOLDER}} values.
# Deliberately no shell wrapper, no `bash -lc`, no nvm — the unit executes the
# node binary directly so startup cannot depend on $HOME or login-shell state
# (the fragility recorded in CS-INF-010).

[Unit]
Description={{APP_NAME}} API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User={{APP_USER}}
Group={{APP_USER}}

# The `current` symlink points at a versioned release directory
# ({{APP_DIR}}/releases/{{VERSION}}), keeping the running version pinned and
# traceable (OPS-030.2); rollback is a symlink flip + restart (see reference/deployment).
WorkingDirectory={{APP_DIR}}/current
ExecStart={{NODE_BIN}} {{APP_DIR}}/current/apps/api/dist/index.js
Restart=on-failure
RestartSec=5

# Non-secret configuration only (SEC-010.1); SOCX_ENV makes the environment
# tier identifiable at runtime (OPS-010.2).
Environment=NODE_ENV=production
Environment=SOCX_ENV={{ENVIRONMENT}}
Environment=PORT={{APP_PORT}}

# Secrets via systemd credentials (ADR-130, SEC-010.3) — the application reads
# $CREDENTIALS_DIRECTORY/<name> at startup (APP-010: read once, passed down).
LoadCredential=db_password:{{CREDENTIALS_DIR}}/{{APP_NAME}}/db_password
LoadCredential=jwt_secret:{{CREDENTIALS_DIR}}/{{APP_NAME}}/jwt_secret

# Hardening — secure by default; loosen ReadWritePaths only for paths the app owns.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{APP_DIR}}/shared

# journald capture; log format/content is governed by OPS-050 (app-side).
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{APP_NAME}}-api

[Install]
WantedBy=multi-user.target
